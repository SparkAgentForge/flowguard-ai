# Runtime and API. In Docker Compose, the API container listens on this port.
FLOWGUARD_ENV=development
FLOWGUARD_PIP_INDEX_URL=https://pypi.org/simple
FLOWGUARD_API_HOST=0.0.0.0
FLOWGUARD_API_PORT=8000

# PostgreSQL is the production database. This localhost URL is for running the
# API directly on the host; Compose supplies its internal postgres URL.
# Tests must use a separate PostgreSQL database, never the application database.
# FLOWGUARD_TEST_DATABASE_URL=postgresql+pg8000://flowguard:flowguard@localhost:5432/flowguard_test
FLOWGUARD_DATABASE_URL=postgresql+pg8000://flowguard:flowguard@localhost:5432/flowguard

# RustFS object storage. The internal endpoint is used by the API container;
# when running the API directly on the host, change it to http://localhost:9000.
# Optional endpoint for callers explicitly requesting presigned URLs. Browser
# video/clip playback streams through the API (including Range requests), so
# RustFS does not need a public port. Step 5
# receives inline image data, so RustFS does not need a public address for AI.
FLOWGUARD_OBJECT_STORAGE_ENDPOINT=http://rustfs:9000
FLOWGUARD_OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
FLOWGUARD_OBJECT_STORAGE_BUCKET=flowguard
# Replace all example credentials before exposing RustFS beyond localhost.
FLOWGUARD_OBJECT_STORAGE_ACCESS_KEY=flowguard
FLOWGUARD_OBJECT_STORAGE_SECRET_KEY=change-me
FLOWGUARD_OBJECT_STORAGE_REGION=us-east-1
RUSTFS_ACCESS_KEY=flowguard
RUSTFS_SECRET_KEY=change-me

# Video inference provider: mock (local deterministic demo), stepfun (Step 5),
# or deepstream (the separately deployed official DeepStream SOP service).
FLOWGUARD_INFERENCE_PROVIDER=mock

# Step 5 OpenAI-compatible endpoint and request settings. Required when the
# provider or PDF SOP extractor is set to stepfun.
FLOWGUARD_STEPFUN_API_KEY=
FLOWGUARD_STEPFUN_BASE_URL=https://api.stepfun.com/v1
FLOWGUARD_STEPFUN_MODEL=step-5-preview
FLOWGUARD_STEPFUN_TIMEOUT_SECONDS=180
FLOWGUARD_STEPFUN_STEPS_PER_REQUEST=10

# Official DeepStream SOP service. Keep this service independent from
# FlowGuard business rules; configure these only when using deepstream.
FLOWGUARD_DEEPSTREAM_BASE_URL=http://nvds-action-sop:8300
FLOWGUARD_DEEPSTREAM_API_KEY=
FLOWGUARD_DEEPSTREAM_TIMEOUT_SECONDS=300

# Step 5 video sampling. Frames are written to RustFS for evidence, then sent
# to the model as base64 data URLs; large frame counts increase request size.
FLOWGUARD_STEPFUN_FRAME_INTERVAL_SECONDS=1
FLOWGUARD_STEPFUN_MAX_VIDEO_FRAMES=300
# Step 5 analyzes overlapping windows instead of sending a long video as one
# sparse request. A 20-second window with 4 seconds overlap keeps action
# boundaries visible while staying below multimodal image limits.
FLOWGUARD_STEPFUN_ANALYSIS_WINDOW_SECONDS=20
FLOWGUARD_STEPFUN_ANALYSIS_WINDOW_OVERLAP_SECONDS=4

# Legacy/demo sampling settings used by the generic provider paths.
FLOWGUARD_FRAME_INTERVAL_SECONDS=3
FLOWGUARD_MAX_VIDEO_FRAMES=20

# The API needs both commands for Step 5/DeepStream video processing. Set
# absolute paths only when the binaries are not on PATH.
FLOWGUARD_FFMPEG_BINARY=ffmpeg
FLOWGUARD_FFPROBE_BINARY=ffprobe

# Evidence below this confidence threshold becomes a targeted human review.
FLOWGUARD_MANUAL_REVIEW_CONFIDENCE_THRESHOLD=60

# SOP extraction: stepfun renders PDF pages to RustFS images; rule_based is
# deterministic and intended for DOCX/local tests only.
FLOWGUARD_SOP_EXTRACTOR_PROVIDER=stepfun
FLOWGUARD_SOP_MANUAL_PAGE_DPI=144
FLOWGUARD_SOP_MANUAL_MAX_PAGES=50

# Local upload directory and request size limits.
FLOWGUARD_UPLOAD_DIR=./data/uploads
FLOWGUARD_MAX_UPLOAD_BYTES=20971520
FLOWGUARD_MAX_VIDEO_BYTES=524288000

# Web app API origin. Change this when the API is served from another host.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Standalone AI result UI. It opens one result page per returned URL and keeps
# management operations in apps/web. Set the reviewer id only when the result
# page should allow exception/rework actions; leave it empty for read-only use.
FLOWGUARD_AGENT_WEB_PORT=5174
FLOWGUARD_AGENT_WEB_URL=http://localhost:5174
VITE_AGENT_API_BASE_URL=/api/v1
VITE_AGENT_REVIEWER_ID=
